# No key is required for the scripted demo.
# Copy this file to .env.local using VS Code's file explorer.
# Live mode requires BOTH a private API key and a model available to your account.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
# Configure only the provider(s) you use. Choose one in the app or CLI.

# Local: optional password. Hosted: required before using live mode or Slack.
APP_PASSWORD=

# Local runs/approvals use .agent-data/state.json. Hosted saved runs need Redis.
# Use your own Upstash REST credentials, stored only on the server.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
STORE_NAMESPACE=rtqa-agent-lab

# Optional Slack integration. APP_PASSWORD must also be set.
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_TEAM_ID=
SLACK_CHANNEL_ID=
# Comma-separated Slack member IDs authorized to approve or reject.
SLACK_APPROVER_IDS=

# Optional limits. The code clamps these to a bounded classroom range.
MAX_RUNS_PER_DAY=30
PORT=3000
